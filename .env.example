# Anthropic API key. If unset, users can paste a key into the in-app Settings screen.
ANTHROPIC_API_KEY=

# Optional. If set, the app gates access with a password (HMAC-signed session cookie).
# Leave blank for local dev / open mode.
AUTH_PASSWORD=

# Required only if AUTH_PASSWORD is set. Used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000
